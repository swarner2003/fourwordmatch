Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. EXCLUDE YOUR BACKEND: If URL starts with your API route prefix, do not rewrite it
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^ - [L]

# 2. If the requested file or folder actually exists, serve it normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Otherwise, pass the routing to index.html
RewriteRule ^ index.html [L]